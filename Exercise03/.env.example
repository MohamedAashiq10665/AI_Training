# Exercise03 environment configuration
# Copy this file to .env and replace placeholder values as needed.

# Required for weather enrichment endpoint calls.
# Leave empty in source control and set a real key in your local/secret store.
OPENWEATHER_API_KEY=

# Optional bearer token for JSONPlaceholder demonstration calls.
# JSONPlaceholder does not require auth for basic usage.
JSONPLACEHOLDER_BEARER_TOKEN=

# External API resilience settings (safe defaults for local development).
EXTERNAL_TIMEOUT_SECONDS=5.0
EXTERNAL_MAX_RETRIES=2
EXTERNAL_BACKOFF_SECONDS=0.25
